# PostgreSQL (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Torn API key for auction collectors:
#   npm run auction-sync:full  — one-time full scan (manual)
#   npm run auction-sync:head  — loop first page only (local daemon)
#   Netlify `sync-auction-house` — scheduled first-page poll (production)
# Exact name expected by Netlify; locally you may use TORN_API_KEY instead.
TORN_AUCTION_API_KEY=""
# TORN_API_KEY=""

# Netlify scheduled function `sync-auction-house` (optional)
# If set, manual GET/POST must use ?secret=... or Authorization: Bearer ...
# Scheduled invocations (POST + next_run body) are allowed without this.
AUCTION_SYNC_CRON_SECRET=""
